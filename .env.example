# Exquis Environment Configuration
# Copy this file to .env and fill in your values

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# API Keys (at least one required)
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LLM Provider: nvidia_nim, openai, anthropic, google, ollama
LLM_PROVIDER=nvidia_nim

# Security
EXQUIS_SECRET_KEY=CHANGE_ME_RANDOM_STRING
EXQUIS_API_KEY=CHANGE_ME_ANOTHER_STRING

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
